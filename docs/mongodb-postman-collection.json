{
  "info": {
    "name": "Go Blueprint — MongoDB Integration",
    "description": "Test collection for the MongoDB product catalog and customer preferences integration.\n\nSuggested flow:\n1. Register → Login (stores the token automatically)\n2. Create Customer\n3. Create Products (electronics, clothing, books)\n4. Get / List / Search Products\n5. Upsert Customer Preferences (references the IDs created above)\n6. Archive Product",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",    "value": "http://localhost:8080/api/v1" },
    { "key": "token",       "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "product_id",  "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@example.com\",\n  \"name\": \"Dev User\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login (stores token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('token', res.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create customer (stores ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.id) { pm.collectionVariables.set('customer_id', res.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/customers",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Silva\",\n  \"email\": \"alice@example.com\",\n  \"birth_date\": \"1990-06-15\"\n}"
            }
          }
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get customer by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers/{{customer_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Products (MongoDB)",
      "item": [
        {
          "name": "Create product — Electronics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.id) { pm.collectionVariables.set('product_id', res.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro X1\",\n  \"description\": \"High-performance laptop with 32GB RAM and 1TB NVMe SSD\",\n  \"sku\": \"ELEC-LAPTOP-001\",\n  \"category\": \"electronics\",\n  \"price_cents\": 599900,\n  \"attributes\": {\n    \"voltage\": \"110-240V\",\n    \"warranty_months\": 24,\n    \"connectivity\": [\"USB-C\", \"HDMI\", \"WiFi 6\", \"Bluetooth 5.2\"]\n  },\n  \"variants\": [\n    {\n      \"sku_suffix\": \"SILVER\",\n      \"stock_units\": 15,\n      \"attributes\": { \"color\": \"silver\" }\n    },\n    {\n      \"sku_suffix\": \"BLACK\",\n      \"stock_units\": 8,\n      \"attributes\": { \"color\": \"black\" }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create product — Clothing",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camiseta Algodão Premium\",\n  \"description\": \"Camiseta 100% algodão, corte slim, disponível em várias cores\",\n  \"sku\": \"CLOTH-TSHIRT-001\",\n  \"category\": \"clothing\",\n  \"price_cents\": 8990,\n  \"attributes\": {\n    \"material\": \"cotton\",\n    \"sizes\": [\"P\", \"M\", \"G\", \"GG\"],\n    \"colors\": [\"white\", \"black\", \"navy\"],\n    \"gender\": \"unisex\"\n  },\n  \"variants\": [\n    {\n      \"sku_suffix\": \"P-WHITE\",\n      \"stock_units\": 30,\n      \"attributes\": { \"size\": \"P\", \"color\": \"white\" }\n    },\n    {\n      \"sku_suffix\": \"M-BLACK\",\n      \"stock_units\": 25,\n      \"attributes\": { \"size\": \"M\", \"color\": \"black\" }\n    },\n    {\n      \"sku_suffix\": \"G-NAVY\",\n      \"stock_units\": 20,\n      \"attributes\": { \"size\": \"G\", \"color\": \"navy\" }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create product — Books",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Designing Data-Intensive Applications\",\n  \"description\": \"The big ideas behind reliable, scalable, and maintainable systems by Martin Kleppmann\",\n  \"sku\": \"BOOK-DDIA-001\",\n  \"category\": \"books\",\n  \"price_cents\": 19900,\n  \"attributes\": {\n    \"author\": \"Martin Kleppmann\",\n    \"isbn\": \"978-1491903124\",\n    \"pages\": 616,\n    \"language\": \"english\"\n  },\n  \"variants\": [\n    {\n      \"sku_suffix\": \"PAPERBACK\",\n      \"stock_units\": 50,\n      \"attributes\": { \"format\": \"paperback\" }\n    },\n    {\n      \"sku_suffix\": \"EBOOK\",\n      \"stock_units\": 999,\n      \"attributes\": { \"format\": \"ebook\" }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get product by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/{{product_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List all products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List by category — electronics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?category=electronics&limit=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "electronics" },
                { "key": "limit",    "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "List by category + attribute filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?category=clothing&attributes[material]=cotton&limit=20",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "category",               "value": "clothing" },
                { "key": "attributes[material]",   "value": "cotton" },
                { "key": "limit",                  "value": "20" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Full-text search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?q=laptop&limit=5",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "q",     "value": "laptop" },
                { "key": "limit", "value": "5" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Full-text search com filtro de categoria",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?q=data&category=books&limit=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "q",        "value": "data" },
                { "key": "category", "value": "books" },
                { "key": "limit",    "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/products/{{product_id}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro X1 (Atualizado)\",\n  \"description\": \"High-performance laptop com upgrade de 64GB RAM\",\n  \"price_cents\": 649900,\n  \"attributes\": {\n    \"voltage\": \"110-240V\",\n    \"warranty_months\": 36,\n    \"connectivity\": [\"USB-C\", \"HDMI\", \"WiFi 6E\", \"Bluetooth 5.3\"]\n  }\n}"
            }
          }
        },
        {
          "name": "Archive product (soft delete)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/products/{{product_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create product — SKU duplicado (espera 409)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Outro Laptop\",\n  \"description\": \"Teste de SKU duplicado\",\n  \"sku\": \"ELEC-LAPTOP-001\",\n  \"category\": \"electronics\",\n  \"price_cents\": 100000,\n  \"attributes\": {},\n  \"variants\": [\n    { \"sku_suffix\": \"A\", \"stock_units\": 1, \"attributes\": {} }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create product — categoria inválida (espera 422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produto Inválido\",\n  \"sku\": \"INVALID-001\",\n  \"category\": \"categoria_inexistente\",\n  \"price_cents\": 1000,\n  \"variants\": [\n    { \"sku_suffix\": \"A\", \"stock_units\": 1, \"attributes\": {} }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get product — ID inválido (espera 400)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/nao-e-um-objectid",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Customer Preferences (MongoDB)",
      "item": [
        {
          "name": "Upsert preferences",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/customers/{{customer_id}}/preferences",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favorite_categories\": [\"electronics\", \"books\"],\n  \"watchlist\": [\"{{product_id}}\"]\n}"
            }
          }
        },
        {
          "name": "Get preferences",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers/{{customer_id}}/preferences",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Upsert preferences — idempotente (segunda chamada)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/customers/{{customer_id}}/preferences",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favorite_categories\": [\"electronics\", \"books\", \"clothing\"],\n  \"watchlist\": [\"{{product_id}}\"]\n}"
            }
          }
        },
        {
          "name": "Get preferences — customer inexistente (espera 404)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers/00000000-0000-0000-0000-000000000000/preferences",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get preferences — ID inválido (espera 400)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers/nao-e-uuid/preferences",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/health"
          }
        }
      ]
    }
  ]
}
